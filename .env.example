# Neon Postgres connection string (server-only, never exposed to the client)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# FormSubmit AJAX endpoint that emails sales@kentbespokecarpentry.co.uk
FORMSUBMIT_ENDPOINT="https://formsubmit.co/ajax/sales@kentbespokecarpentry.co.uk"

# Canonical site URL (used for metadata, sitemap, robots, JSON-LD)
NEXT_PUBLIC_SITE_URL="https://www.kentbespokecarpentry.co.uk"

# Optional: Vercel Blob token for storing inspiration uploads (step 3 of the booking modal).
# Auto-provided when a Blob store is linked to the Vercel project. Without it, uploads are
# skipped gracefully and only file names are emailed.
BLOB_READ_WRITE_TOKEN=""
